---
interface Props {
  index: string;
  label: string;
  title: string;
  script?: string;
  sub?: string;
  id: string;
  total?: string;
  /** Less room below and a title that shrinks a little on short screens (helps the section fit one screen). */
  compact?: boolean;
  /** Each title word on its own line, so the script sits beside the last one instead of on a row of its own. */
  stack?: boolean;
  /** A smaller title, so a one-line title leaves room for the script beside it. */
  small?: boolean;
}
const { index, label, title, script, sub, id, total = '08', compact = false, stack = false, small = false } = Astro.props;
const words = title.split(' ');
---
<header class:list={['shead', compact && 'shead--compact', stack && 'shead--stack', small && 'shead--small']}>
  <div class="shead__meta t-micro" data-reveal>
    <span class="idx"><b>({index})</b> {label}</span>
    <span aria-hidden="true">{index} / {total}</span>
  </div>
  <div class="shead__titlewrap">
    <h2 class="shead__title t-display" id={id} data-split>
      {words.map((w, i) => (
        <Fragment><span class="w-mask"><span class="w">{w}</span></span>{i < words.length - 1 && ' '}</Fragment>
      ))}
    </h2>
    {script && <span class="shead__accent" aria-hidden="true" data-script>{script}</span>}
  </div>
  {sub && <p class="shead__sub" data-reveal>{sub}</p>}
</header>
