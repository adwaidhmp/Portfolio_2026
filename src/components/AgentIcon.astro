---
// Agentic-AI mark: an AI sparkle at the core, orbited by three tool nodes that
// light up in turn, like an agent calling its tools. Animated in CSS (.ag).
---
<svg class="ag" viewBox="0 0 32 32" aria-hidden="true">
  <g class="ag__orbit">
    <circle cx="16" cy="16" r="11.6" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="1.6 2.4" opacity=".55" />
    <path d="M16 16 L16 4.4 M16 16 L26.05 21.8 M16 16 L5.95 21.8" fill="none" stroke="currentColor" stroke-width=".9" opacity=".4" />
    <circle class="ag__node" cx="16" cy="4.4" r="2.4" style="animation-delay:0s" />
    <circle class="ag__node" cx="26.05" cy="21.8" r="2.4" style="animation-delay:.8s" />
    <circle class="ag__node" cx="5.95" cy="21.8" r="2.4" style="animation-delay:1.6s" />
  </g>
  <path class="ag__spark" d="M16 8.8 C16.8 13 19 15.2 23.2 16 C19 16.8 16.8 19 16 23.2 C15.2 19 13 16.8 8.8 16 C13 15.2 15.2 13 16 8.8Z" />
</svg>
