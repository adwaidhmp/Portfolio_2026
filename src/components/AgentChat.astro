---
import { agentSuggestions, profile, contact } from '../data/portfolio';
import AgentIcon from './AgentIcon.astro';
---
<!-- Small teaser bubble above the agent button: shows for 3s after load, then every 2 minutes (agent.ts).
     Hidden from screen readers and keyboard: the agent button below does the same job. -->
<button class="agent-hint" type="button" data-agent-hint data-open="false" aria-hidden="true" tabindex="-1">
  <!-- a tiny terminal, same feel as the chat window: title bar, then "❯ Ask me anything" types itself out -->
  <span class="agent-hint__bar">
    <span class="agent-hint__dots"><i></i><i></i><i></i></span>
    <span class="agent-hint__label"><i class="agent-hint__dot"></i>AI agent · 24/7</span>
    <span class="agent-hint__arrow">↗</span>
  </span>
  <span class="agent-hint__body">
    <span class="agent-hint__line"><span class="agent-hint__prompt">❯</span><span class="agent-hint__type"><span class="agent-hint__cmd">Ask me anything</span><i class="agent-hint__cursor"></i></span></span>
    <span class="agent-hint__out">Hi, I'm {profile.firstName}'s AI agent.</span>
  </span>
</button>

<button class="agent-fab" type="button" aria-expanded="false" aria-controls="agent" aria-label="Ask my AI agent" data-agent-open>
  <span class="agent-fab__orb" aria-hidden="true"><AgentIcon /><i class="agent-fab__badge">1</i></span>
  <span class="agent-fab__label">Ask my AI agent</span>
</button>

<!-- data-lenis-prevent: the page's smooth scroll leaves wheel/touch inside the chat alone, so the log scrolls -->
<section class="agent" id="agent" role="dialog" aria-modal="false" aria-labelledby="agent-title" data-agent data-open="false" data-lenis-prevent>
  <header class="agent__head">
    <span class="agent__avatar" aria-hidden="true"><AgentIcon /></span>
    <p class="agent__title" id="agent-title" style="margin:0"><b>agent@adwaidh</b>: ~/portfolio</p>
    <button class="agent__close" type="button" aria-label="Close chat" data-agent-close>
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1l10 10M11 1 1 11" stroke="currentColor" stroke-width="1.5" /></svg>
    </button>
  </header>
  <div class="agent__log" aria-live="polite" data-agent-log></div>
  <!-- Suggested questions: two rows in a strip that scrolls sideways (wheel, drag, swipe or the arrows) -->
  <div class="agent__sugwrap" data-sugwrap>
    <button class="agent__sugnav agent__sugnav--prev" type="button" aria-label="Scroll questions left" data-sug-step="-1">
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M7.5 2 3.5 6l4 4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
    </button>
    <div class="agent__sugs" role="group" aria-label="Suggested questions" data-agent-sugs data-lenis-prevent>
      {[agentSuggestions.slice(0, Math.ceil(agentSuggestions.length / 2)), agentSuggestions.slice(Math.ceil(agentSuggestions.length / 2))].map((row) => (
        <div class="agent__sugrow">{row.map((q) => <button type="button">{q}</button>)}</div>
      ))}
    </div>
    <button class="agent__sugnav agent__sugnav--next" type="button" aria-label="Scroll questions right" data-sug-step="1">
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="m4.5 2 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
    </button>
  </div>
  <form class="agent__form" data-agent-form>
    <span aria-hidden="true">❯</span>
    <label class="sr-only" for="agent-input">Ask a question about Adwaidh</label>
    <input id="agent-input" type="text" autocomplete="off" placeholder="Ask about skills, MCP, relocation…" maxlength="200" />
    <!-- Voice input (agent.ts shows it only where the browser can do speech recognition, e.g. Chrome) -->
    <button type="button" class="agent__mic" aria-label="Speak your question" aria-pressed="false" data-agent-mic hidden>
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="1.5" width="5" height="8.5" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M3 7.5a5 5 0 0 0 10 0M8 12.5V15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
    </button>
    <button type="submit" aria-label="Send question">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
    </button>
  </form>

  <!-- After every 2 messages the agent offers a ready-made message to Adwaidh (filled in by agent.ts):
       the visitor adds their name + email, can edit the subject and message, then Send or Ignore. -->
  <form class="agent__draft" data-agent-draft data-open="false" data-endpoint={contact.formEndpoint} data-email={contact.email}
        role="dialog" aria-labelledby="agent-draft-title" novalidate inert>
    <div class="agent__draft-head">
      <span class="agent__draft-icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16"><path d="M2 4.5h12v8H2zM2.5 5l5.5 4.2L13.5 5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
      </span>
      <div>
        <p class="agent__draft-title" id="agent-draft-title">Message {profile.firstName}?</p>
        <p class="agent__draft-sub">I drafted it from our chat. Add your details, edit anything, then send.</p>
      </div>
    </div>
    <div class="agent__draft-row">
      <label><span>Your name</span><input name="name" type="text" autocomplete="name" placeholder="Jane Doe" maxlength="80" /></label>
      <label><span>Your email</span><input name="email" type="email" autocomplete="email" placeholder="you@company.com" maxlength="120" required /></label>
    </div>
    <label><span>Subject</span><input name="subject" type="text" maxlength="140" required /></label>
    <label><span>Message</span><textarea name="message" rows="5" maxlength="2000" required></textarea></label>
    <p class="agent__draft-status" role="status" aria-live="polite" data-draft-status></p>
    <div class="agent__draft-actions">
      <button type="button" class="agent__draft-ignore" data-draft-ignore>Ignore</button>
      <button type="submit" class="agent__draft-send">Send
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
      </button>
    </div>
  </form>
</section>
<div class="toast" role="status" aria-live="polite" data-toast></div>
