---
import SectionHeader from './SectionHeader.astro';
import { faq } from '../data/portfolio';
---
<section id="faq" class="section" aria-labelledby="faq-title" data-section>
  <div class="container-x">
    <SectionHeader index="08" label="FAQ" title="Questions" script="asked a lot" id="faq-title" compact />
    <div class="faq__list">
      {faq.map((item, i) => (
        <details class="faq__item" open={i === 0} data-reveal>
          <summary>
            <h3 class="faq__q">{item.q}</h3>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <p class="faq__a">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__list { max-width: 920px; border-top: 1px solid var(--line); }
  .faq__item { border-bottom: 1px solid var(--line); }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(16px, 2vw, 24px) 0;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 6px; }
  .faq__q {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    font-weight: 600;
    line-height: 1.35;
    transition: color .3s;
  }
  .faq__item summary:hover .faq__q { color: var(--accent-ink); }
  .faq__icon {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition: transform .4s var(--ease-out-expo), border-color .3s, background-color .3s;
  }
  .faq__icon::before, .faq__icon::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
  }
  .faq__icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq__item[open] .faq__icon { transform: rotate(45deg); border-color: var(--accent); background: rgb(var(--accent-rgb) / .12); }
  .faq__a { margin: 0; padding: 0 48px clamp(18px, 2vw, 26px) 0; color: var(--fg-2); line-height: 1.6; max-width: 72ch; }

  @media (max-width: 640px) { .faq__a { padding-right: 0; } }
</style>
