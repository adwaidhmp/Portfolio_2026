---
import SectionHeader from './SectionHeader.astro';
import { about, profile } from '../data/portfolio';

// Emphasise key phrases in the summary (keeps the data file plain text).
const emphasis = ['agentic AI systems in production', 'autonomous coding agent on the Claude API', 'MCP servers', 'DevOps and cloud deployment', 'RAG and LangGraph'];
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
let summary = esc(about.summary);
for (const p of emphasis) summary = summary.replace(esc(p), `<em>${esc(p)}</em>`);
const tags = ['Claude API', 'MCP', 'AI Agents', 'LangGraph', 'RAG', 'Python', 'Django', 'FastAPI', 'Docker', 'AWS', 'Cloudflare', 'Nginx', 'PM2'];
const tone = ['stat--gold', '', '', 'stat--light'];
---
<section id="about" class="section" aria-labelledby="about-title" data-section>
  <div class="container-x">
    <SectionHeader index="01" label="About" title="Who I am" id="about-title" />
    <div class:list={['about__grid', profile.photo && 'has-photo']}>
      {profile.photo && (
        <figure class="about__photo" data-reveal>
          <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="534" height="721" loading="lazy" decoding="async" />
          <figcaption>
            <span class="about__photo-tag t-micro"><i aria-hidden="true"></i> Open to work</span>
            <span>
              <span class="about__photo-name">{profile.name}</span>
              <span class="about__photo-role t-micro">{profile.shortTitle} · {profile.location}</span>
            </span>
          </figcaption>
        </figure>
      )}
      <div class="glass about__summary" data-reveal>
        <p set:html={summary} />
        <div class="about__tags">
          {tags.map((t) => <span class="pill">{t}</span>)}
        </div>
      </div>
      <ul class="about__stats" role="list" style="list-style:none;margin:0;padding:0">
        {about.highlights.map((h, i) => (
          <li class={`stat glass ${tone[i] ?? ''}`} data-reveal="tilt">
            <span class="xh spin" aria-hidden="true"></span>
            <div class="stat__num">
              <span data-count={h.value} data-decimals={h.decimals}>{h.value.toFixed(h.decimals)}</span>{h.suffix && <sup>{h.suffix}</sup>}
            </div>
            <p class="stat__label">{h.label}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
