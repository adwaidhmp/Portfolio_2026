---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Adwaidh MP" description="This page does not exist." noindex>
  <main style="min-height:100svh;display:grid;place-items:center;text-align:center;padding:24px">
    <div style="display:grid;gap:18px;justify-items:center">
      <p class="t-micro">Error // 404</p>
      <h1 class="t-display" style="font-size:clamp(4rem,18vw,14rem);margin:0">4<span style="color:var(--color-gold)">0</span>4</h1>
      <p style="margin:0;max-width:40ch">The agent searched every node and couldn't find this page.</p>
      <a class="btn btn--gold" href="/">Back to the portfolio</a>
    </div>
  </main>
</Base>
